<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del pie de página del vendor.

    Sutil: cream un punto más oscuro que el fondo, hairline gold arriba. No
    es decorativo — la franja dorada arriba es la misma que cierra el header,
    así header y pie "se dan la mano" cromáticamente.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_alt" />
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_secondary_soft" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>
