<?xml version="1.0" encoding="utf-8"?>
<!--
    Botón principal "¡ACEPTO!" — negro con borde dorado, como el mockup.

    Reemplaza el botón blanco de la paleta provisional. El estado `pressed` sube
    al gris carbón en vez de bajar a negro puro: sobre un fondo crema, oscurecer
    más no se percibe, aclarar sí.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A2A28" />
            <stroke
                android:width="2dp"
                android:color="@color/koaj_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FF6E6A63" />
            <stroke
                android:width="2dp"
                android:color="@color/koaj_card_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/koaj_black" />
            <stroke
                android:width="2dp"
                android:color="@color/koaj_gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
