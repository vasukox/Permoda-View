<?xml version="1.0" encoding="utf-8"?>
<!--
    Banner de aviso (DIAN caída, documento no registrado).

    Fondo cream + borde izquierdo gold para destacar sin alarmar. La franja
    lateral de 4dp es el patrón estándar de "esto es una nota informativa,
    no un error".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_alt" />
            <stroke
                android:width="1dp"
                android:color="@color/border_default" />
        </shape>
    </item>
    <item android:gravity="start" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_secondary" />
        </shape>
    </item>
</layer-list>
