<?xml version="1.0" encoding="utf-8"?>
<!-- Acción primaria Vitrina: tinta plana, esquina de vinilo (2dp), foco con filo dorado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ink_raised" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ink" />
            <stroke android:width="3dp" android:color="@color/vitrina_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ink" />
        </shape>
    </item>
</selector>
