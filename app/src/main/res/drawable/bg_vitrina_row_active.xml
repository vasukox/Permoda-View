<?xml version="1.0" encoding="utf-8"?>
<!-- Fila que el cajero está escribiendo: placa hueso con filete dorado a la izquierda. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ground_alt" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/vitrina_gold" />
        </shape>
    </item>
</layer-list>
