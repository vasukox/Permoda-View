<?xml version="1.0" encoding="utf-8"?>
<!--
    Campo «Caja»: caja blanca con borde de 1dp; al enfocar, borde azul de 2dp
    sobre un halo tenue. Bloqueado: fondo gris sin borde marcado.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="140"
    android:exitFadeDuration="180">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/caja_ground" />
            <stroke android:width="1dp" android:color="@color/caja_rule" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="@color/caja_surface" />
                    <stroke android:width="2dp" android:color="@color/caja_primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/caja_surface" />
            <stroke android:width="1dp" android:color="@color/caja_field_border" />
        </shape>
    </item>
</selector>
