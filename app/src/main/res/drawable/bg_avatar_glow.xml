    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="120dp"
        android:centerX="0.5"
        android:centerY="0.5"
        android:startColor="#5522D3EE"
        android:endColor="#0022D3EE" />
</shape>
