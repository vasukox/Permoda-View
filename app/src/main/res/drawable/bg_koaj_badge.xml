<?xml version="1.0" encoding="utf-8"?>
<!--
    Badge / chip para etiquetas (escenario, contador, hints).

    Pill con fondo gold_pale + borde gold: se lee como "etiqueta de marca"
    sin tener que competir con un botón. Lo usan el scenario badge y los
    chips de estado de la cabecera del vendor.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="40dp" />
    <solid android:color="@color/accent_secondary_pale" />
    <stroke
        android:width="1dp"
        android:color="@color/border_accent" />
</shape>
