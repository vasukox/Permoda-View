<?xml version="1.0" encoding="utf-8"?>
<!--
    Chip del candado "información segura".

    Píldora con el mismo verde salvia que el badge de escenario del vendor,
    para que el ojo identifique "esto viene del mismo sistema". Fondo
    semitransparente para que respire sobre el negro del card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="40dp" />
    <solid android:color="#1AC9A227" />
    <stroke
        android:width="1dp"
        android:color="#66C9A227" />
</shape>
