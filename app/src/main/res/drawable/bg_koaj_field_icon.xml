<?xml version="1.0" encoding="utf-8"?>
<!--
    Marco del icono de cada campo del cliente.

    Sustituye a `bg_field_icon_blue` (azul pálido plano). Gold_pale con
    hairline gold: el icono se lee como parte del sistema de marca y no
    como un chip de sistema operativo.

    Radio 12dp para que el cuadrado de 40dp quede "squircle" y no compita
    con el radio 22 del card que lo contiene.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/accent_secondary_pale" />
    <stroke
        android:width="1dp"
        android:color="@color/border_accent" />
    <corners android:radius="12dp" />
</shape>
