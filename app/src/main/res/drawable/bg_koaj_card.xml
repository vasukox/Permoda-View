<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de beneficio: blanca, esquina suave y borde apenas visible.
     El borde es de 1dp a propósito: en el mockup las tarjetas se separan del
     fondo crema por contraste de tono, no por una línea marcada. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/koaj_card" />
    <stroke
        android:width="1dp"
        android:color="@color/koaj_card_border" />
    <corners android:radius="10dp" />
</shape>
