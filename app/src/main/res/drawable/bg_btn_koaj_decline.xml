<?xml version="1.0" encoding="utf-8"?>
<!--
    Botón "NO ACEPTO" — blanco con borde tenue.

    Es deliberadamente discreto: en el mockup la jerarquía la marca el botón
    negro de aceptar. Aun así es un botón real y no un link, porque negarse tiene
    que ser una acción cómoda de pulsar en una pantalla táctil, no un texto
    pequeño que hay que cazar.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/koaj_tan" />
            <stroke
                android:width="1dp"
                android:color="@color/koaj_card_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/koaj_card" />
            <stroke
                android:width="1dp"
                android:color="@color/koaj_card_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
