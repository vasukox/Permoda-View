<?xml version="1.0" encoding="utf-8"?>
<!-- Acción secundaria: filete gris de 1dp; la tinta queda reservada a la primaria. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ground_alt" />
            <stroke android:width="1dp" android:color="@color/vitrina_rule_strong" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/vitrina_ground" />
            <stroke android:width="2dp" android:color="@color/vitrina_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/vitrina_rule_strong" />
        </shape>
    </item>
</selector>
