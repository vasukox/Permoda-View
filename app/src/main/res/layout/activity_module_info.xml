<?xml version="1.0" encoding="utf-8"?>
<!--
    Ficha del módulo · sistema «Caja». Es lo que ve quien toca el ícono en la
    terminal: informativa y útil para soporte (versión, módulo, paquete, los tres
    datos que se piden por teléfono cuando el POS no activa el módulo).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caja_ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banda marina con el rótulo del módulo. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/caja_navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/caja_info_pad_h"
            android:paddingVertical="22dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_caja_icon_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/module_info_title"
                    android:src="@drawable/ic_koaj_store"
                    android:tint="@color/caja_on_navy"
                    tools:ignore="UseAppTint" />
            </FrameLayout>

            <TextView
                style="@style/CajaBandTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/module_info_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/caja_info_pad_h"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_caja_panel"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                style="@style/CajaBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/module_info_body"
                android:textSize="16sp" />

            <TextView
                style="@style/CajaFieldLabel"
                android:layout_marginTop="28dp"
                android:text="@string/module_info_support_label" />

            <!-- Ficha técnica: la puebla ModuleInfoActivity desde BuildConfig y ApiActions. -->
            <TextView
                android:id="@+id/info_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_caja_type_box"
                android:fontFamily="@font/plex_sans_medium"
                android:fontFeatureSettings="tnum"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:textColor="@color/caja_text"
                android:textIsSelectable="true"
                android:textSize="15sp"
                tools:text="Versión 1\nMódulo custvalidation\ncom.permoda.facturacion" />

            <Button
                android:id="@+id/info_close"
                style="@style/CajaButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="@string/module_info_close" />

            <!-- Driver de QA: GONE salvo en debug (ModuleInfoActivity con BuildConfig.DEBUG). -->
            <Button
                android:id="@+id/info_open_driver"
                style="@style/CajaButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/module_info_open_driver"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
