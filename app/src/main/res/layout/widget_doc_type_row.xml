<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del selector de tipo de documento (CC, TI, NIT…). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/doc_type_row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        tools:text="CC" />

    <ImageView
        android:id="@+id/doc_type_row_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@string/consent_doc_type_selected"
        android:src="@drawable/ic_check"
        app:tint="@color/accent_secondary"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
