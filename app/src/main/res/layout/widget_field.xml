<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de campo del cliente · sistema «Vitrina Koaj». Dos modos:
      · DISPLAY (visible por defecto) — placa de ícono + rótulo + valor, tappable.
      · EDIT    (oculto por defecto)  — EditText, se aplica al teclear.

    Rótulo en voz condensada (la misma placa que VendorFieldLabel del cajero) y
    valor en tinta a buen tamaño: el cliente lo lee desde el otro lado del
    mostrador. ConsentScreen pinta el rótulo en rojo cuando el campo falta y
    vuelve al color de este XML.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- MODO DISPLAY -->
    <LinearLayout
        android:id="@+id/field_display_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_row_ripple"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <!-- Ícono suelto, sin placa: la fila respira y el dato manda. -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="18dp">

            <ImageView
                android:id="@+id/field_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.7"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_email" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/field_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:textColor="@color/vitrina_text_muted"
                android:textSize="13sp"
                tools:text="Correo" />

            <TextView
                android:id="@+id/field_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/vitrina_text"
                android:textSize="20sp"
                tools:text="juan.perez@empresa.com" />
        </LinearLayout>
    </LinearLayout>

    <!-- MODO EDIT: lo escrito se aplica al instante; sale del modo al perder el foco. -->
    <LinearLayout
        android:id="@+id/field_edit_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/field_edit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/vitrina_text_muted"
            android:textSize="13sp"
            tools:text="Correo" />

        <EditText
            android:id="@+id/field_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_vitrina_field"
            android:fontFamily="sans-serif"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:textColor="@color/vitrina_text"
            android:textColorHint="@color/vitrina_text_muted"
            android:textCursorDrawable="@null"
            android:textSize="20sp"
            tools:ignore="LabelFor" />

        <!-- Contador: solo al acercarse al límite. -->
        <TextView
            android:id="@+id/field_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:textColor="@color/vitrina_text_soft"
            android:textSize="13sp"
            android:visibility="invisible"
            tools:text="55/60"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
