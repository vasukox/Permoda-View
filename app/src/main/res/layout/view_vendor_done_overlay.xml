<?xml version="1.0" encoding="utf-8"?>
<!--
    Overlay "flow completado" · sistema «Caja».

    Se muestra al final del flujo (DONE) durante el beat antes de devolver
    el resultado al POS. Las animaciones (CompletionAnimator en VendorScreen.kt)
    son las mismas de siempre; solo cambian superficie y colores:
      · Velo gris frío translúcido sobre la pantalla
      · Tarjeta blanca con sombra, check verde de estado y anillo que se traza
      · Confeti en la paleta azul (bg_caja_particle_*)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vendor_done_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_done_backdrop"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/vendor_done_card"
        android:layout_width="@dimen/done_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_done_card"
        android:clickable="false"
        android:elevation="16dp"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="@dimen/done_card_padding_v">

        <!-- Marca del módulo (CompletionAnimator la anima por id). -->
        <TextView
            android:id="@+id/vendor_done_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_sans_medium"
            android:letterSpacing="0.08"
            android:text="@string/vendor_eyebrow"
            android:textColor="@color/caja_text_muted"
            android:textSize="@dimen/done_eyebrow_text" />

        <FrameLayout
            android:layout_width="@dimen/done_check_size"
            android:layout_height="@dimen/done_check_size"
            android:layout_marginTop="24dp">

            <!-- Halo verde detrás del check. Respira 1.0 → 1.18 → 1.0 -->
            <View
                android:id="@+id/vendor_done_halo"
                android:layout_width="@dimen/done_ring_size"
                android:layout_height="@dimen/done_ring_size"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_done_halo" />

            <!-- Anillo que se traza al entrar -->
            <View
                android:id="@+id/vendor_done_ring"
                android:layout_width="@dimen/done_ring_size"
                android:layout_height="@dimen/done_ring_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_done_ring" />

            <ImageView
                android:id="@+id/vendor_done_check"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_done_check_path"
                app:tint="@color/caja_success" />
        </FrameLayout>

        <TextView
            android:id="@+id/vendor_done_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/plex_sans_semibold"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:text="@string/vendor_done_title_accepted"
            android:textColor="@color/caja_text"
            android:textSize="@dimen/done_title_text" />

        <TextView
            android:id="@+id/vendor_done_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/plex_sans_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/vendor_done_subtitle_accepted"
            android:textColor="@color/caja_text_soft"
            android:textSize="@dimen/done_subtitle_text" />
    </LinearLayout>

    <!--
        Contenedor de confetti. Las partículas se inflan dinámicamente
        en CompletionAnimator. Vive fuera del card para que el card no
        las recorte y para que la lluvia sea visible sobre el backdrop.
    -->
    <FrameLayout
        android:id="@+id/vendor_done_confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />
</FrameLayout>
