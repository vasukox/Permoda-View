<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla del CLIENTE en la 10"/11" · sistema «Vitrina Koaj».

    El trámite usa los tokens `vitrina_*` (colors_vitrina.xml): blanco de
    trabajo, voz de rótulo condensada y el documento en numerales grandes de
    vinilo, para que el cliente lo vea crecer mientras el cajero escribe. La
    espera del cajero es un panel de tinta a sangre.

    ⚠️ `zone_loyalty` (Koaj Lovers) NO forma parte de este sistema: se conserva
    tal cual la aprobó marca, con sus `koaj_*`, sus estilos KoajPerk* y sus
    drawables. No uniformarla con las demás zonas.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vitrina_ground">

    <LinearLayout
        android:id="@+id/zone_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:indeterminateTint="@color/vitrina_gold" />

        <TextView
            android:id="@+id/loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:letterSpacing="0.16"
            android:text="@string/state_loading"
            android:textAllCaps="true"
            android:textColor="@color/vitrina_text_soft"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Selector de tipo de documento: fondo que cierra al tap + panel que no consume taps. -->
    <FrameLayout
        android:id="@+id/zone_doc_type_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/doc_type_picker_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/doc_type_picker_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="48dp"
            android:background="@drawable/bg_vitrina_panel"
            android:clickable="false"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/VitrinaHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/consent_doc_type_dialog_title"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/doc_type_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>

    <ImageButton
        android:id="@+id/keyboard_dismiss"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_vitrina_btn_primary"
        android:contentDescription="@string/consent_hide_keyboard"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_keyboard_hide"
        app:tint="@color/vitrina_on_ink"
        android:visibility="gone" />

    <!--
        Espera de la decisión del cajero: panel de tinta a sangre, como la
        vitrina antes de abrir. El cliente no tiene acción aquí a propósito.
    -->
    <LinearLayout
        android:id="@+id/zone_waiting_vendor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_ink"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="56dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.03"
            android:lineSpacingMultiplier="0.95"
            android:text="@string/state_waiting_vendor_title"
            android:textAllCaps="true"
            android:textColor="@color/vitrina_on_ink"
            android:textSize="38sp" />

        <View
            android:layout_width="56dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="@color/vitrina_gold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/state_waiting_vendor_subtitle"
            android:textColor="@color/vitrina_on_ink_soft"
            android:textSize="16sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vitrina_gold" />
    </LinearLayout>

    <!-- Documento en vivo: el número crece en numerales de vinilo mientras el cajero escribe. -->
    <ScrollView
        android:id="@+id/zone_awaiting_document"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="64dp"
            android:paddingTop="56dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/awaiting_prompt"
                style="@style/VitrinaHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:text="@string/state_awaiting_validating"
                android:textSize="28sp" />

            <LinearLayout
                android:id="@+id/awaiting_field_doc_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/consent_label_doc_type"
                    android:src="@drawable/ic_id"
                    app:tint="@color/vitrina_text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:letterSpacing="0.14"
                    android:text="@string/consent_label_doc_type"
                    android:textAllCaps="true"
                    android:textColor="@color/vitrina_text_muted"
                    android:textSize="13sp" />

                <!-- Sin lápiz: el cliente no edita, solo mira lo que el cajero digita. -->
                <TextView
                    android:id="@+id/awaiting_field_doc_type_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vitrina_badge"
                    android:fontFamily="@font/barlow_condensed_semibold"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="3dp"
                    android:text="CC"
                    android:textColor="@color/vitrina_text"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:letterSpacing="0.14"
                android:text="@string/consent_label_doc_id"
                android:textAllCaps="true"
                android:textColor="@color/vitrina_text_muted"
                android:textSize="13sp" />

            <!-- El número sigue siendo el protagonista, ahora en semibold. -->
            <EditText
                android:id="@+id/awaiting_field_doc_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_vitrina_field"
                android:fontFamily="@font/barlow_condensed_semibold"
                android:hint="@string/consent_doc_id_hint"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="number"
                android:letterSpacing="0.06"
                android:maxLength="20"
                android:paddingBottom="12dp"
                android:textColor="@color/vitrina_text"
                android:textColorHint="@color/vitrina_text_muted"
                android:textCursorDrawable="@null"
                android:textSize="64sp"
                tools:ignore="LabelFor" />

            <Button
                android:id="@+id/btn_continue"
                style="@style/VitrinaButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="8dp"
                android:text="@string/consent_continue" />

            <TextView
                android:id="@+id/awaiting_link_reject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/consent_reject"
                android:textColor="@color/vitrina_text_soft"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/zone_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="64dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/consent_title"
                style="@style/VitrinaHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/consent_title"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/consent_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="32dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/consent_subtitle"
                android:textColor="@color/vitrina_text_soft"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:orientation="vertical">

                <include android:id="@+id/field_name" layout="@layout/widget_field" />
                <View style="@style/VitrinaRowRule" />
                <include android:id="@+id/field_doc_type" layout="@layout/widget_field" />
                <View style="@style/VitrinaRowRule" />
                <include android:id="@+id/field_doc_id" layout="@layout/widget_field" />
                <View style="@style/VitrinaRowRule" />
                <include android:id="@+id/field_email" layout="@layout/widget_field" />
                <View style="@style/VitrinaRowRule" />
                <include android:id="@+id/field_phone" layout="@layout/widget_field" />
            </LinearLayout>

            <TextView
                android:id="@+id/warning_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_vitrina_notice"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:textColor="@color/vitrina_text_soft"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="No se pudo validar con DIAN. Datos no verificados."
                tools:visibility="visible" />

            <!-- Qué falta para aceptar; el botón queda deshabilitado en paralelo. -->
            <TextView
                android:id="@+id/validation_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:drawablePadding="8dp"
                android:textColor="@color/vitrina_error"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Para continuar: Faltan: Nombre y apellido, Correo"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btn_accept"
                style="@style/VitrinaButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp"
                android:text="@string/consent_accept" />

            <!-- Consumidor Final vive solo en la pantalla del cajero. -->
            <TextView
                android:id="@+id/link_reject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="48dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/consent_reject"
                android:textColor="@color/vitrina_text_soft"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Cierre: el verde dice «listo» como estado, sobre blanco de trabajo. -->
    <LinearLayout
        android:id="@+id/zone_confirmed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_ground"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginBottom="28dp">

            <View
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_vitrina_success_disc" />

            <ImageView
                android:id="@+id/confirmed_check"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:contentDescription="@string/state_confirmed"
                android:src="@drawable/ic_check"
                app:tint="@color/vitrina_on_ink" />
        </FrameLayout>

        <TextView
            android:id="@+id/confirmed_title"
            style="@style/VitrinaHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="48dp"
            android:gravity="center"
            android:text="@string/state_confirmed"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/confirmed_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="48dp"
            android:gravity="center"
            android:textColor="@color/vitrina_text_soft"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Tus descuentos ya están activos"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_rejected"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_ground_alt"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/state_rejected"
            android:src="@drawable/ic_reject_circle" />

        <TextView
            style="@style/VitrinaHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="48dp"
            android:gravity="center"
            android:text="@string/state_rejected" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_ground"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/state_error"
            android:src="@drawable/ic_error_red" />

        <TextView
            style="@style/VitrinaHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/state_error" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:textColor="@color/vitrina_text_soft"
            android:textSize="16sp"
            tools:text="No se pudo leer el XML del cliente." />

        <Button
            android:id="@+id/btn_retry"
            style="@style/VitrinaButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/consent_retry" />
    </LinearLayout>


    <!-- ================================================================= -->
    <!-- Comunidad Koaj Lovers.                                            -->
    <!--                                                                   -->
    <!-- Diseño calcado del mockup aprobado por marca: cabecera negra con   -->
    <!-- el wordmark, hero fotográfico con el título en overlay, y bloque   -->
    <!-- crema con los cuatro beneficios y la llamada a la acción.          -->
    <!--                                                                   -->
    <!-- Se muestra SIEMPRE tras el Aceptar del cliente, en los tres        -->
    <!-- escenarios. La jerarquía la marca el botón negro con borde         -->
    <!-- dorado: unirse es la acción obvia, y "NO ACEPTO" queda discreto    -->
    <!-- pero sigue siendo un botón cómodo de pulsar, no un link diminuto.  -->
    <!--                                                                   -->
    <!-- âš ï¸ La foto del hero es un placeholder (res/drawable/koaj_hero.xml).-->
    <!-- Para poner la real: borrar ese archivo y dejar la imagen como      -->
    <!-- `koaj_hero.webp`. El layout no se toca. Ver el comentario del      -->
    <!-- propio koaj_hero.xml.                                             -->
    <!-- ================================================================= -->
    <!--
        âš ï¸ KOAJ LOVERS: NO usar ScrollView. El cliente debe ver toda la
        pantalla sin deslizar, sea en la pantalla de 10" (961x601 dp) o en la
        de 11" (~1280x800 dp). El cálculo vertical vive en el comentario de
        `values/dimens.xml`.
    -->
    <LinearLayout
        android:id="@+id/zone_loyalty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/koaj_cream"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Cabecera negra con el wordmark KOAJ. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/koaj_black"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:letterSpacing="0.32"
                android:paddingVertical="@dimen/koaj_header_pad_v"
                android:text="@string/koaj_brand"
                android:textColor="@color/text_inverse"
                android:textSize="@dimen/koaj_header_text" />

            <!-- ==================================================== -->
            <!-- HERO: texto a la izquierda, modelos recortados a la  -->
            <!-- derecha, sobre el degradado oscuro.                  -->
            <!--                                                      -->
            <!-- Es un LinearLayout horizontal y no un FrameLayout con -->
            <!-- la foto de fondo, porque `koaj_hero.png` es un        -->
            <!-- recorte con transparencia y vertical (1420x1568). En  -->
            <!-- una banda ancha, un centerCrop lo escalaría por el    -->
            <!-- ancho y recortaría arriba y abajo: se perderían las   -->
            <!-- caras. Con dos columnas la imagen entra completa y el -->
            <!-- texto nunca queda encima de los modelos.              -->
            <!-- ==================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/koaj_hero_height"
                android:background="@drawable/bg_koaj_hero_dark"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/koaj_hero_pad_start"
                    android:paddingEnd="12dp"
                    android:paddingBottom="@dimen/koaj_hero_pad_bottom">

                    <TextView
                        android:id="@+id/koaj_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.3"
                        android:text="@string/koaj_eyebrow"
                        android:textColor="@color/koaj_gold_soft"
                        android:textSize="@dimen/koaj_eyebrow_text" />

                    <!-- Contenedor: el título son dos líneas con estilos
                         distintos, y ConsentScreen lo anima como un bloque. -->
                    <LinearLayout
                        android:id="@+id/koaj_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.02"
                            android:text="@string/koaj_title_main"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/koaj_title_text"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="serif"
                                android:includeFontPadding="false"
                                android:text="@string/koaj_title_lovers"
                                android:textColor="@color/koaj_gold_soft"
                                android:textSize="@dimen/koaj_title_text"
                                android:textStyle="bold|italic" />

                            <ImageView
                                android:id="@+id/koaj_heart"
                                android:layout_width="@dimen/koaj_title_heart"
                                android:layout_height="@dimen/koaj_title_heart"
                                android:layout_marginStart="6dp"
                                android:contentDescription="@string/koaj_title"
                                android:src="@drawable/ic_heart_gold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/koaj_rule_width"
                        android:layout_height="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/koaj_gold" />

                    <!-- Contenedor: el tagline mezcla tres estilos y
                         ConsentScreen lo anima como un bloque. -->
                    <LinearLayout
                        android:id="@+id/koaj_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/koaj_tagline_plain"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/koaj_tagline_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/koaj_tagline_accent"
                            android:textColor="@color/koaj_gold_soft"
                            android:textSize="@dimen/koaj_tagline_text"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.9"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/koaj_subtitle"
                            android:textColor="@color/text_inverse"
                            android:textSize="@dimen/koaj_subtitle_text" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                    Los modelos. `wrap_content` + `adjustViewBounds` + `fitEnd`
                    hacen que la ImageView se dimensione sola respetando el
                    aspecto del recorte: ocupa los 330dp de alto y toma el ancho
                    que le corresponda, anclada abajo a la derecha. Así la
                    imagen nunca se estira ni se recorta, y el texto de la
                    izquierda se queda con el ancho sobrante.
                -->
                <ImageView
                    android:id="@+id/koaj_hero_image"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/koaj_title"
                    android:scaleType="fitEnd"
                    android:src="@drawable/koaj_hero" />
            </LinearLayout>

            <!-- ================================= -->
            <!-- BENEFICIOS + LLAMADA A LA ACCIÃ“N  -->
            <!-- ================================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/koaj_cream"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/koaj_section_pad_h"
                android:paddingTop="@dimen/koaj_section_pad_top"
                android:paddingBottom="@dimen/koaj_section_pad_bottom">

                <!-- El título mezcla dos colores ("KOAJ LOVER" en dorado). Se
                     compone con tres TextViews en fila en vez de un Spannable:
                     el estilo queda visible en el layout y no hay que tocar
                     Kotlin para un cambio de copy. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/koaj_perks_title_plain"
                        android:textColor="@color/koaj_ink"
                        android:textSize="@dimen/koaj_perks_title_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/koaj_perks_title_accent"
                        android:textColor="@color/koaj_gold"
                        android:textSize="@dimen/koaj_perks_title_text"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/koaj_perks_title_tail"
                        android:textColor="@color/koaj_ink"
                        android:textSize="@dimen/koaj_perks_title_text" />
                </LinearLayout>

                <!-- Separador con corazón, como el mockup. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="34dp"
                        android:layout_height="1dp"
                        android:background="@color/koaj_gold_soft" />

                    <ImageView
                        android:layout_width="@dimen/koaj_divider_heart"
                        android:layout_height="@dimen/koaj_divider_heart"
                        android:layout_marginHorizontal="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_heart_gold" />

                    <View
                        android:layout_width="34dp"
                        android:layout_height="1dp"
                        android:background="@color/koaj_gold_soft" />
                </LinearLayout>

                <!-- Cuatro beneficios en fila: aprovecha el ancho de la
                     pantalla del cliente sin empujar el botón fuera de vista. -->
                <LinearLayout
                    android:id="@+id/koaj_perks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/koaj_perk_1"
                        style="@style/KoajPerkCard"
                        android:layout_marginEnd="@dimen/koaj_perk_card_gap">

                        <FrameLayout style="@style/KoajPerkIconFrame">
                            <ImageView
                                style="@style/KoajPerkIcon"
                                android:contentDescription="@string/koaj_perk_events_title"
                                android:src="@drawable/ic_koaj_ticket" />
                        </FrameLayout>

                        <TextView
                            style="@style/KoajPerkTitle"
                            android:text="@string/koaj_perk_events_title" />

                        <TextView
                            style="@style/KoajPerkBody"
                            android:text="@string/koaj_perk_events_body" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/koaj_perk_2"
                        style="@style/KoajPerkCard"
                        android:layout_marginEnd="@dimen/koaj_perk_card_gap">

                        <FrameLayout style="@style/KoajPerkIconFrame">
                            <ImageView
                                style="@style/KoajPerkIcon"
                                android:contentDescription="@string/koaj_perk_discounts_title"
                                android:src="@drawable/ic_koaj_tag" />
                        </FrameLayout>

                        <TextView
                            style="@style/KoajPerkTitle"
                            android:text="@string/koaj_perk_discounts_title" />

                        <TextView
                            style="@style/KoajPerkBody"
                            android:text="@string/koaj_perk_discounts_body" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/koaj_perk_3"
                        style="@style/KoajPerkCard"
                        android:layout_marginEnd="@dimen/koaj_perk_card_gap">

                        <FrameLayout style="@style/KoajPerkIconFrame">
                            <ImageView
                                style="@style/KoajPerkIcon"
                                android:contentDescription="@string/koaj_perk_launch_title"
                                android:src="@drawable/ic_koaj_megaphone" />
                        </FrameLayout>

                        <TextView
                            style="@style/KoajPerkTitle"
                            android:text="@string/koaj_perk_launch_title" />

                        <TextView
                            style="@style/KoajPerkBody"
                            android:text="@string/koaj_perk_launch_body" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/koaj_perk_4"
                        style="@style/KoajPerkCard">

                        <FrameLayout style="@style/KoajPerkIconFrame">
                            <ImageView
                                style="@style/KoajPerkIcon"
                                android:contentDescription="@string/koaj_perk_news_title"
                                android:src="@drawable/ic_koaj_mail" />
                        </FrameLayout>

                        <TextView
                            style="@style/KoajPerkTitle"
                            android:text="@string/koaj_perk_news_title" />

                        <TextView
                            style="@style/KoajPerkBody"
                            android:text="@string/koaj_perk_news_body" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/koaj_divider_heart"
                        android:layout_height="@dimen/koaj_divider_heart"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_heart_gold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/koaj_cta_headline"
                        android:textColor="@color/koaj_ink"
                        android:textSize="@dimen/koaj_cta_headline_text"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/koaj_cta_sub"
                    android:textColor="@color/koaj_ink_soft"
                    android:textSize="@dimen/koaj_cta_sub_text" />

                <!-- Botón principal. Es un LinearLayout y no un Button porque
                     lleva dos líneas con color y tamaño distintos, como el
                     mockup; `clickable` + `focusable` le dan el mismo
                     comportamiento y ConsentScreen sólo le pone un listener. -->
                <LinearLayout
                    android:id="@+id/btn_koaj_accept"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_btn_koaj"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/koaj_accept_pad_v">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/koaj_accept_heart"
                            android:layout_height="@dimen/koaj_accept_heart"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_heart_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/koaj_accept"
                            android:textColor="@color/koaj_btn_text"
                            android:textSize="@dimen/koaj_accept_text"
                            android:textStyle="bold" />
                    </LinearLayout>

<TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/koaj_accept_sub"
                        android:textColor="@color/koaj_gold_soft"
                        android:textSize="@dimen/koaj_accept_sub_text" />
                </LinearLayout>

                <Button
                    android:id="@+id/link_koaj_skip"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/koaj_skip_height"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_btn_koaj_decline"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="@string/koaj_skip"
                    android:textColor="@color/koaj_ink_soft"
                    android:textSize="@dimen/koaj_skip_text" />

                <LinearLayout
                    android:id="@+id/koaj_free_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/koaj_hint_icon"
                        android:layout_height="@dimen/koaj_hint_icon"
                        android:layout_marginEnd="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_koaj_lock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/koaj_free_hint"
                        android:textColor="@color/koaj_ink_soft"
                        android:textSize="@dimen/koaj_hint_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/koaj_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.6"
                    android:textColor="@color/koaj_ink_soft"
                    android:textSize="@dimen/koaj_countdown_text"
                    android:visibility="invisible"
                    tools:text="Continuando en 5â€¦"
                    tools:visibility="visible" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_no_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vitrina_ground"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/VitrinaHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_no_data"
            android:textColor="@color/vitrina_text_soft"
            android:textSize="26sp" />
    </LinearLayout>
</FrameLayout>
